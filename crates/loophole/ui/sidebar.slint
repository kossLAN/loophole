import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { VmItem } from "state.slint";
import { Button, ButtonKind, Icon, IconButton, StatusDot } from "components/index.slint";

export component Sidebar inherits Rectangle {
    in property <[VmItem]> vms;
    in property <int> selected;
    in property <bool> creating;
    callback select(int);
    callback new-vm();
    callback about();

    width: Theme.sidebar-w;
    background: Theme.sidebar;
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: Theme.space-3;
        spacing: Theme.space-1;
        HorizontalLayout {
            padding-left: 6px;
            padding-top: 6px;
            padding-bottom: Theme.space-3;
            spacing: 10px;
            Text {
                text: "loophole";
                color: Theme.fg;
                font-size: 17px;
                font-weight: 700;
                letter-spacing: 0.3px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.info;
                    tooltip: "About";
                    clicked => { root.about(); }
                }
            }
        }
        Text {
            text: "MACHINES";
            color: Theme.subtle;
            font-size: Theme.font-xs;
            font-weight: 600;
            letter-spacing: 1px;
            height: 32px;
            vertical-alignment: bottom;
        }
        for vm[i] in root.vms: Rectangle {
            height: Theme.row-h;
            border-radius: Theme.radius-md;
            background: i == root.selected && !root.creating ? Theme.light : row.has-hover ? Theme.hover : transparent;
            accessible-role: list-item;
            accessible-label: vm.name;
            accessible-item-selectable: true;
            accessible-item-selected: i == root.selected;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    StatusDot {
                        state: vm.state;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: vm.name;
                        color: Theme.fg;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: vm.windows;
                        color: Theme.muted;
                        font-size: Theme.font-xs;
                        overflow: elide;
                    }
                }
            }
            row := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.select(i); }
            }
        }
        if root.vms.length == 0: Text {
            text: "No VMs yet";
            color: Theme.muted;
            font-size: Theme.font-md;
            horizontal-alignment: center;
            height: 40px;
            vertical-alignment: center;
        }
        Rectangle {
            vertical-stretch: 1;
        }
        Button {
            text: "New VM";
            icon: Icons.plus;
            kind: root.creating ? ButtonKind.primary : ButtonKind.secondary;
            clicked => { root.new-vm(); }
        }
    }
}
