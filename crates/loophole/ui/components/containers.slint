import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { ButtonKind, Icon, IconButton, Badge, Tone, Hint } from "base.slint";

export component Card inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <image> action-icon;
    in property <string> action-tooltip;
    in property <bool> action-enabled: true;
    in property <ButtonKind> action-kind: ButtonKind.ghost;
    in property <bool> warning;
    callback action();

    preferred-width: Theme.card-w;
    min-width: 300px;
    horizontal-stretch: 1;
    spacing: 6px;

    if root.title != "": HorizontalLayout {
        height: 22px;
        padding-left: 4px;
        padding-right: 2px;
        spacing: 6px;
        Text {
            text: root.title.to-uppercase();
            vertical-alignment: center;
            color: Theme.muted;
            font-size: Theme.font-xs;
            font-weight: 500;
            letter-spacing: 0.44px;
            horizontal-stretch: 1;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: root.warning ? Theme.warn : Theme.muted;
            font-size: Theme.font-xs;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.action-icon.width > 0: IconButton {
            icon: root.action-icon;
            tooltip: root.action-tooltip;
            enabled: root.action-enabled;
            kind: root.action-kind;
            size: 22px;
            clicked => { root.action(); }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.light;
        VerticalLayout {
            padding: 4px;
            spacing: 0px;
            alignment: start;
            @children
        }
    }
}

export component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> detail;
    spacing: Theme.space-2;
    padding-left: 4px;
    Text {
        text: root.text.to-uppercase();
        color: Theme.muted;
        font-size: Theme.font-xs;
        font-weight: 500;
        letter-spacing: 0.44px;
        vertical-alignment: center;
    }
    Text {
        text: root.detail;
        color: Theme.muted;
        font-size: Theme.font-xs;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    @children
}

export component ScrollArea inherits Rectangle {
    in-out property <length> content-y <=> flick.content-y;
    clip: true;
    min-width: 50px;
    min-height: 50px;
    preferred-width: 100%;
    preferred-height: 100%;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        @children
    }

    property <length> overflow: flick.content-height - flick.height;
    if root.overflow > 0px: Rectangle {
        x: parent.width - 8px;
        width: bar-touch.has-hover || bar-touch.pressed ? 6px : 4px;
        height: max(28px, flick.height * flick.height / flick.content-height);
        y: (flick.height - self.height) * (-flick.content-y / root.overflow);
        border-radius: 3px;
        background: bar-touch.has-hover || bar-touch.pressed ? Theme.muted : Theme.light;
        animate width { duration: Theme.anim; }

        bar-touch := TouchArea {
            property <length> start-y;
            property <length> start-content;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    self.start-y = self.mouse-y;
                    self.start-content = flick.content-y;
                }
            }
            moved => {
                if (self.pressed) {
                    let track = flick.height - parent.height;
                    let delta = (self.mouse-y - self.start-y) * root.overflow / max(1px, track);
                    flick.content-y = max(-root.overflow, min(0px, self.start-content - delta));
                }
            }
        }
    }
}

export component Modal inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <length> panel-width: 460px;
    callback close();

    background: Theme.overlay;
    TouchArea {
        clicked => { root.close(); }
    }
    panel := Rectangle {
        width: min(root.panel-width, root.width - 32px);
        height: min(body.preferred-height, root.height - 32px);
        border-radius: Theme.radius-lg;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.light;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close();
                    return accept;
                }
                reject
            }
        }
        body := VerticalLayout {
            padding: Theme.space-3;
            spacing: Theme.space-3;
            HorizontalLayout {
                min-height: Theme.row-h;
                padding-left: 6px;
                spacing: 10px;
                if root.icon.width > 0: VerticalLayout {
                    alignment: center;
                    Icon {
                        source: root.icon;
                    }
                }
                Text {
                    text: root.title;
                    color: Theme.fg;
                    font-size: Theme.font-lg;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.x;
                        tooltip: "Close";
                        clicked => { root.close(); }
                    }
                }
            }
            @children
        }
    }
}

export struct TabItem {
    label: string,
    icon: image,
    issues: int,
}

export component TabBar inherits Rectangle {
    in property <[TabItem]> tabs;
    in-out property <int> current;
    height: 36px;
    min-width: 120px;
    preferred-width: row.preferred-width + 8px;
    max-width: row.preferred-width + 8px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    background: Theme.mid;
    border-width: 1px;
    border-color: Theme.light;
    accessible-role: tab-list;

    Flickable {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        content-width: row.preferred-width;
        row := HorizontalLayout {
            height: parent.height;
            spacing: 4px;
            for item[i] in root.tabs: Rectangle {
                border-radius: Theme.radius-sm;
                background: i == root.current ? Theme.light : tab-touch.has-hover ? Theme.hover : transparent;
                accessible-role: AccessibleRole.tab;
                accessible-label: item.label;
                animate background { duration: Theme.anim; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            source: item.icon;
                            color: i == root.current ? Theme.fg : Theme.muted;
                        }
                    }
                    Text {
                        text: item.label;
                        color: i == root.current ? Theme.fg : Theme.muted;
                        font-size: Theme.font-md;
                        vertical-alignment: center;
                    }
                    if item.issues > 0: VerticalLayout {
                        alignment: center;
                        Badge {
                            text: item.issues;
                            tone: Tone.danger;
                        }
                    }
                }
                tab-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.current = i; }
                }
            }
        }
    }
}

export struct MenuItem {
    text: string,
    icon: image,
    enabled: bool,
    danger: bool,
}

export component MenuButton inherits IconButton {
    in property <[MenuItem]> items;
    in property <length> menu-width: 230px;
    callback activated(int);

    clicked => { menu.show(); }

    menu := PopupWindow {
        x: root.width - root.menu-width;
        y: root.height + 4px;
        width: root.menu-width;
        height: root.items.length * Theme.list-row-h + 10px;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.light;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;
            VerticalLayout {
                padding: 5px;
                for item[i] in root.items: entry := Rectangle {
                    height: Theme.list-row-h;
                    property <float> dim: item.enabled ? 0 : 0.6;
                    border-radius: Theme.radius-md;
                    background: item-touch.has-hover && item.enabled ? Theme.light : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: item.icon;
                                color: (item.danger ? Theme.danger : Theme.fg).transparentize(entry.dim);
                            }
                        }
                        Text {
                            text: item.text;
                            color: (item.danger ? Theme.danger : Theme.fg).transparentize(entry.dim);
                            font-size: Theme.font-md;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    item-touch := TouchArea {
                        enabled: item.enabled;
                        mouse-cursor: pointer;
                        clicked => { root.activated(i); }
                    }
                }
            }
        }
    }
}

export component Tile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <image> icon;
    min-width: 140px;
    horizontal-stretch: 1;
    height: 60px;
    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.light;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                color: Theme.fg;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.value;
                color: Theme.fg;
                font-size: Theme.font-lg;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.label;
                color: Theme.muted;
                font-size: Theme.font-md;
                overflow: elide;
            }
        }
    }
}

export component CardFlow inherits FlexboxLayout {
    spacing: Theme.space-4;
    alignment: stretch;
}

export component ListPane inherits VerticalLayout {
    in property <string> title;
    in property <[MenuItem]> add-items;
    in property <bool> add-enabled: true;
    out property <length> header-height: 22px + root.spacing;
    callback add(int);

    width: 240px;
    spacing: 6px;

    HorizontalLayout {
        height: 22px;
        padding-left: 4px;
        padding-right: 2px;
        Text {
            text: root.title.to-uppercase();
            vertical-alignment: center;
            color: Theme.muted;
            font-size: Theme.font-xs;
            font-weight: 500;
            letter-spacing: 0.44px;
            horizontal-stretch: 1;
        }
        if root.add-items.length == 1: IconButton {
            icon: Icons.plus;
            tooltip: root.add-items[0].text;
            enabled: root.add-enabled;
            size: 22px;
            clicked => { root.add(0); }
        }
        if root.add-items.length > 1: MenuButton {
            icon: Icons.plus;
            tooltip: "Add";
            enabled: root.add-enabled;
            size: 22px;
            items: root.add-items;
            activated(i) => { root.add(i); }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.light;
        VerticalLayout {
            padding: 4px;
            spacing: 2px;
            alignment: start;
            @children
        }
    }
}

export component ListRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> selected;
    in property <bool> problem;
    callback clicked();

    height: Theme.row-h;
    border-radius: Theme.radius-md;
    background: root.selected ? Theme.light : touch.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: root.title;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                color: root.problem ? Theme.warn : root.selected ? Theme.fg : Theme.muted;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.fg;
                font-size: Theme.font-md;
                font-weight: 600;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: root.problem ? Theme.warn : Theme.muted;
                font-size: Theme.font-xs;
                overflow: elide;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ListEmpty inherits HorizontalLayout {
    in property <string> text;
    height: 34px;
    padding-left: 10px;
    Text {
        text: root.text;
        color: Theme.muted;
        font-size: Theme.font-md;
        vertical-alignment: center;
    }
}

export component ListGap inherits Rectangle {
    height: Theme.space-3;
}
