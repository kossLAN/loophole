export struct VmItem {
    name: string,
    windows: string,
    // "stopped", "starting", "running", "paused"
    state: string,
    summary: string,
    running: bool,
    paused: bool,
    install-media: bool,
    driver-disc: bool,
}

export struct VmEdit {
    name: string,
    windows: int,
    sockets: int,
    cores: int,
    threads: int,
    manual-topology: bool,
    hyperv: bool,
    memory-gib: int,
    hugepages: int,
    gpu-window: int,
    install: string,
    driver-disc: bool,
    sound: bool,
    microphone: bool,
    tablet: bool,
    boot-menu: bool,
    boot-timeout: int,
    resolution: string,
    refresh: string,
    capture: int,
    tpm: bool,
    machine-options: string,
    extra-args: string,
}

export struct DiskEdit {
    id: int,
    // 0: a new image, 1: an image, 2: a host device
    kind: int,
    path: string,
    new-gib: int,
    bus: int,
    format: int,
    cache: int,
    discard: bool,
    serial: string,
    title: string,
    info: string,
    error: string,
    warning: string,
}

export struct ForwardEdit {
    proto: int,
    address: string,
    host: int,
    guest: int,
}

export struct NicEdit {
    model: int,
    backend: int,
    tap: string,
    mac: string,
    forwards: [ForwardEdit],
    error: string,
}

export struct PciEdit {
    id: int,
    address: string,
    name: string,
    rom-bar: bool,
    status: string,
    ready: bool,
}

export struct UsbEdit {
    id: string,
    name: string,
    status: string,
}

export struct BootEdit {
    label: string,
    detail: string,
    // 0: disk, 1: the installation drive, 2: a PCI device
    kind: int,
    id: int,
    enabled: bool,
}

export struct EditIssues {
    general: string,
    cpu: string,
    memory: string,
    gpu: string,
    media: string,
    sound: string,
    input: string,
    boot: string,
    display: string,
    machine: string,
}

export struct EditOptions {
    hugepages: [string],
    gpu-window-sizes: [string],
    buses: [string],
    formats: [string],
    caches: [string],
    nic-models: [string],
    backends: [string],
    protos: [string],
    captures: [string],
    windows: [string],
}

export struct HostDiskItem {
    path: string,
    title: string,
    detail: string,
    problem: string,
}

export struct HostPciItem {
    address: string,
    title: string,
    detail: string,
    problem: string,
}

export struct HostUsbItem {
    id: string,
    title: string,
    problem: string,
}

export global Edit {
    // 0: nothing, 1: creating, 2: editing a stopped VM, 3: viewing a running one
    in-out property <int> mode;
    in-out property <int> tab;
    in-out property <VmEdit> vm;
    in property <[DiskEdit]> disks;
    in property <[NicEdit]> nics;
    in property <[PciEdit]> pci;
    in property <[UsbEdit]> usb;
    in property <[BootEdit]> boot;
    in property <EditOptions> options;
    in property <EditIssues> issues;
    in property <[int]> tab-issues;
    in property <[string]> warnings;
    in property <string> summary;
    in property <bool> dirty;
    in property <bool> driver-disc-available;
    // The build in the driver drive, and what the switch says about it
    in property <string> driver-disc-name;
    in property <string> driver-disc-hint;
    in property <string> preview;
    in property <string> log;
    in property <string> install-name;
    in property <string> host-cpus;
    in property <string> host-memory;
    in property <string> host-storage;
    in property <[string]> host-hugepages;
    in property <bool> hugepages-available;
    in property <[string]> taps;
    in property <string> taps-hint;
    out property <bool> locked: root.mode == 3;

    callback edited();
    callback apply();
    callback revert();
    callback cancel-create();
    callback browse-install();
    callback add-disk(int);
    callback remove-disk(int);
    callback browse-disk(int);
    callback add-nic();
    callback remove-nic(int);
    callback new-mac(int);
    callback add-forward(int);
    callback remove-forward(int, int);
    callback remove-pci(int);
    callback remove-usb(int);
    callback move-boot(int, int);
    callback pick-device(int);
}

export global HostDevices {
    in property <[HostDiskItem]> disks;
    in property <[HostPciItem]> pci;
    in property <[HostUsbItem]> usb;
    // 0: closed, 1: disks, 2: PCI devices, 3: USB devices
    in-out property <int> picking;
    callback scan();
    callback add-disk(string);
    callback add-pci(string);
    callback add-usb(string);
}
