import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Edit } from "../state.slint";
import {
    Button, Card, CardFlow, FormRow, Notice, NumberField, PathField, Segmented, Switch, TextField, Tone,
} from "../components/index.slint";

// What only a new VM chooses. The other tabs are the ones its settings have later.
export component SetupTab inherits CardFlow {
    Card {
        title: "Machine";
        FormRow {
            label: "Name";
            icon: Icons.app-window;
            hint: "Letters, digits, - _ and .";
            error: Edit.issues.general;
            TextField {
                text <=> Edit.vm.name;
                placeholder: "win11";
            }
        }
        FormRow {
            label: "Version";
            icon: Icons.app-window;
            Segmented {
                model: Edit.options.windows;
                current-index <=> Edit.vm.windows;
            }
        }
    }
    Card {
        title: "System disk";
        if Edit.disks.length == 0: Notice {
            text: "No disks: add one in Storage, or boot from a disc or a passed-through controller";
            tone: Tone.warn;
        }
        for disk[i] in Edit.disks: VerticalLayout {
            spacing: Theme.space-3;
            if i == 0: FormRow {
                label: "Disk";
                icon: Icons.hard-drive;
                error: disk.error;
                Segmented {
                    model: ["New disk", "Existing image", "Host disk"];
                    current-index <=> disk.kind;
                    selected(k) => {
                        if (k == 2) {
                            Edit.pick-device(0);
                        }
                    }
                }
            }
            if i == 0 && disk.kind == 0: FormRow {
                label: "Size";
                icon: Icons.hard-drive;
                hint: Edit.host-storage;
                NumberField {
                    value <=> disk.new-gib;
                    minimum: 64;
                    maximum: 65536;
                    step: 16;
                    unit: "GiB";
                }
            }
            if i == 0 && disk.kind == 1: FormRow {
                label: "Image";
                icon: Icons.hard-drive;
                hint: ".qcow2 or raw";
                PathField {
                    path <=> disk.path;
                    browse => { Edit.browse-disk(0); }
                }
            }
            if i == 0 && disk.kind == 2: FormRow {
                label: "Host disk";
                icon: Icons.hard-drive-download;
                hint: disk.info;
                HorizontalLayout {
                    spacing: 6px;
                    TextField {
                        text <=> disk.path;
                        mono: true;
                        placeholder: "/dev/disk/by-id/…";
                    }
                    Button {
                        text: "Choose…";
                        icon: Icons.hard-drive;
                        clicked => { Edit.pick-device(0); }
                    }
                }
            }
        }
    }
    Card {
        title: "Discs";
        FormRow {
            label: "Installation image";
            icon: Icons.disc-3;
            hint: "Stays in until ejected";
            error: Edit.issues.media;
            PathField {
                path <=> Edit.vm.install;
                placeholder: "Win11_25H2_x64.iso";
                clearable: true;
                browse => { Edit.browse-install(); }
            }
        }
        FormRow {
            label: "loophole driver disc";
            icon: Icons.disc-3;
            hint: Edit.driver-disc-hint;
            Switch {
                checked <=> Edit.vm.driver-disc;
                enabled: Edit.driver-disc-available;
                label: "loophole driver disc";
            }
        }
    }
}
