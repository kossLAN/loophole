import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Edit } from "../state.slint";
import {
    Button, ButtonKind, Card, Divider, FormRow, IconButton, ItemHeader, ListEmpty, ListPane, ListRow,
    Notice, NumberField, Select, TextField, Tone,
} from "../components/index.slint";

export component NetworkTab inherits HorizontalLayout {
    property <int> selected;
    property <int> count: Edit.nics.length;
    property <int> seen;

    init => {
        root.seen = root.count;
        root.selected = 0;
    }
    changed count => {
        if (root.count > root.seen) {
            root.selected = root.count - 1;
        } else if (root.selected >= root.count) {
            root.selected = max(0, root.count - 1);
        }
        root.seen = root.count;
    }

    spacing: Theme.space-4;

    pane := ListPane {
        title: "Network";
        add-items: [{ text: "Add adapter", icon: Icons.plus, enabled: true }];
        add-enabled: !Edit.locked;
        add(k) => { Edit.add-nic(); }
        if Edit.nics.length == 0: ListEmpty {
            text: "None";
        }
        for nic[i] in Edit.nics: ListRow {
            icon: Icons.ethernet-port;
            title: "Adapter " + (i + 1);
            subtitle: Edit.options.nic-models[nic.model] + " · " + Edit.options.backends[nic.backend];
            problem: nic.error != "";
            selected: root.selected == i;
            clicked => { root.selected = i; }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: start;
        padding-top: pane.header-height;
        if Edit.nics.length == 0: Notice {
            text: "No adapters, the VM is offline";
            tone: Tone.info;
        }
        VerticalLayout {
            for nic[i] in Edit.nics: VerticalLayout {
                if i == root.selected: Card {
                    ItemHeader {
                        icon: Icons.ethernet-port;
                        title: Edit.options.nic-models[nic.model];
                        subtitle: Edit.options.backends[nic.backend];
                        error: nic.error;
                        if !Edit.locked: IconButton {
                            icon: Icons.trash-2;
                            tooltip: "Remove";
                            kind: ButtonKind.danger;
                            clicked => { Edit.remove-nic(i); }
                        }
                    }
                    Divider { }
                    FormRow {
                        label: "Model";
                        icon: Icons.ethernet-port;
                        hint: nic.model == 0 ? "Driver built into Windows" : "Fastest, needs virtio-win";
                        Select {
                            model: Edit.options.nic-models;
                            current-index <=> nic.model;
                            enabled: !Edit.locked;
                        }
                    }
                    FormRow {
                        label: "Connection";
                        icon: Icons.network;
                        hint: nic.backend == 0 ? "Shares the host address" : "Joins the LAN through a TAP device on a bridge";
                        Select {
                            model: Edit.options.backends;
                            current-index <=> nic.backend;
                            enabled: !Edit.locked;
                        }
                    }
                    if nic.backend == 1: FormRow {
                        label: "TAP device";
                        icon: Icons.network;
                        hint: Edit.taps-hint;
                        TextField {
                            text <=> nic.tap;
                            placeholder: Edit.taps.length > 0 ? Edit.taps[0] : "tap0";
                            mono: true;
                            enabled: !Edit.locked;
                        }
                    }
                    FormRow {
                        label: "MAC address";
                        icon: Icons.info;
                        hint: "QEMU picks when empty";
                        error: nic.error;
                        HorizontalLayout {
                            spacing: 6px;
                            TextField {
                                text <=> nic.mac;
                                mono: true;
                                placeholder: "52:54:00:12:34:56";
                                enabled: !Edit.locked;
                            }
                            if !Edit.locked: IconButton {
                                icon: Icons.dices;
                                tooltip: "New random address";
                                clicked => { Edit.new-mac(i); }
                            }
                        }
                    }
                    if nic.backend == 0: FormRow {
                        label: "Port forwarding";
                        icon: Icons.arrow-right-left;
                        hint: "Host to guest ports";
                        VerticalLayout {
                            spacing: 6px;
                            for fwd[j] in nic.forwards: HorizontalLayout {
                                spacing: 6px;
                                Select {
                                    model: Edit.options.protos;
                                    current-index <=> fwd.proto;
                                    width: 90px;
                                    enabled: !Edit.locked;
                                }
                                TextField {
                                    text <=> fwd.address;
                                    placeholder: "any address";
                                    mono: true;
                                    enabled: !Edit.locked;
                                }
                                NumberField {
                                    value <=> fwd.host;
                                    field-width: 120px;
                                    minimum: 1;
                                    maximum: 65535;
                                    enabled: !Edit.locked;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: "→";
                                        color: Theme.muted;
                                    }
                                }
                                NumberField {
                                    value <=> fwd.guest;
                                    field-width: 120px;
                                    minimum: 1;
                                    maximum: 65535;
                                    enabled: !Edit.locked;
                                }
                                if !Edit.locked: IconButton {
                                    icon: Icons.x;
                                    tooltip: "Remove";
                                    clicked => { Edit.remove-forward(i, j); }
                                }
                            }
                            if !Edit.locked: HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Forward a port";
                                    icon: Icons.arrow-right-left;
                                    kind: ButtonKind.ghost;
                                    compact: true;
                                    clicked => { Edit.add-forward(i); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
