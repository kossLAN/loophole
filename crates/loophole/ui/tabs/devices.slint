import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Edit } from "../state.slint";
import {
    ButtonKind, Card, Divider, FormRow, IconButton, ItemHeader, ListEmpty, ListLabel, ListPane, ListRow,
    Switch,
} from "../components/index.slint";

export component DevicesTab inherits HorizontalLayout {
    // 0: a PCI device, 1: a USB device, 2: sound
    property <int> kind;
    property <int> index;
    property <int> pci-count: Edit.pci.length;
    property <int> usb-count: Edit.usb.length;
    property <int> pci-seen;
    property <int> usb-seen;

    function first() {
        root.index = 0;
        root.kind = root.pci-count > 0 ? 0 : root.usb-count > 0 ? 1 : 2;
    }

    init => {
        root.pci-seen = root.pci-count;
        root.usb-seen = root.usb-count;
        root.first();
    }
    changed pci-count => {
        if (root.pci-count > root.pci-seen) {
            root.kind = 0;
            root.index = root.pci-count - 1;
        } else if (root.kind == 0 && root.index >= root.pci-count) {
            root.first();
        }
        root.pci-seen = root.pci-count;
    }
    changed usb-count => {
        if (root.usb-count > root.usb-seen) {
            root.kind = 1;
            root.index = root.usb-count - 1;
        } else if (root.kind == 1 && root.index >= root.usb-count) {
            root.first();
        }
        root.usb-seen = root.usb-count;
    }

    spacing: Theme.space-4;

    pane := ListPane {
        title: "Devices";
        add-items: [
            { text: "PCI device", icon: Icons.microchip, enabled: true },
            { text: "USB device", icon: Icons.usb, enabled: true },
        ];
        add-enabled: !Edit.locked;
        add(k) => { Edit.pick-device(k == 0 ? -2 : -3); }
        ListLabel {
            text: "PCI";
        }
        if Edit.pci.length == 0: ListEmpty {
            text: "None";
        }
        for dev[i] in Edit.pci: ListRow {
            icon: Icons.microchip;
            title: dev.name;
            subtitle: dev.address;
            problem: !dev.ready;
            selected: root.kind == 0 && root.index == i;
            clicked => {
                root.kind = 0;
                root.index = i;
            }
        }
        ListLabel {
            text: "USB";
        }
        if Edit.usb.length == 0: ListEmpty {
            text: "None";
        }
        for dev[i] in Edit.usb: ListRow {
            icon: Icons.usb;
            title: dev.name;
            subtitle: dev.id;
            problem: dev.status != "";
            selected: root.kind == 1 && root.index == i;
            clicked => {
                root.kind = 1;
                root.index = i;
            }
        }
        ListLabel {
            text: "Other";
        }
        ListRow {
            icon: Icons.volume-2;
            title: "Sound";
            subtitle: !Edit.vm.sound ? "Off" : Edit.vm.microphone ? "Speakers and microphone" : "Speakers";
            selected: root.kind == 2;
            clicked => { root.kind = 2; }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: start;
        padding-top: pane.header-height;
        VerticalLayout {
            for dev[i] in Edit.pci: VerticalLayout {
                if root.kind == 0 && root.index == i: Card {
                    ItemHeader {
                        icon: Icons.microchip;
                        title: dev.name;
                        subtitle: dev.ready ? dev.address : dev.address + " · " + dev.status;
                        warning: !dev.ready;
                        if !Edit.locked: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.trash-2;
                                tooltip: "Remove";
                                kind: ButtonKind.danger;
                                clicked => { Edit.remove-pci(i); }
                            }
                        }
                    }
                    Divider { }
                    FormRow {
                        label: "Option ROM";
                        icon: Icons.microchip;
                        hint: "The device's own boot firmware";
                        Switch {
                            checked <=> dev.rom-bar;
                            enabled: !Edit.locked;
                            label: "Option ROM";
                        }
                    }
                }
            }
        }
        VerticalLayout {
            for dev[i] in Edit.usb: VerticalLayout {
                if root.kind == 1 && root.index == i: Card {
                    ItemHeader {
                        icon: Icons.usb;
                        title: dev.name;
                        subtitle: dev.status == "" ? dev.id : dev.id + " · " + dev.status;
                        warning: dev.status != "";
                        if !Edit.locked: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.trash-2;
                                tooltip: "Remove";
                                kind: ButtonKind.danger;
                                clicked => { Edit.remove-usb(i); }
                            }
                        }
                    }
                }
            }
        }
        if root.kind == 2: Card {
            FormRow {
                label: "Sound card";
                icon: Icons.volume-2;
                hint: "HD Audio through PipeWire";
                Switch {
                    checked <=> Edit.vm.sound;
                    enabled: !Edit.locked;
                    label: "Sound card";
                }
            }
            FormRow {
                label: "Microphone";
                icon: Icons.mic;
                hint: "Host default input";
                Switch {
                    checked <=> Edit.vm.microphone;
                    enabled: !Edit.locked && Edit.vm.sound;
                    label: "Microphone";
                }
            }
        }
    }
}
