import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Edit } from "../state.slint";
import { CardFlow, Card, FormRow, Select, Switch, TextField } from "../components/index.slint";

export component DisplayTab inherits CardFlow {
    Card {
        title: "Display";
        subtitle: "on attach";
        FormRow {
            label: "Resolution";
            icon: Icons.monitor;
            hint: "Follows the window when empty";
            error: Edit.issues.display;
            TextField {
                text <=> Edit.vm.resolution;
                placeholder: "follow the window";
                mono: true;
            }
        }
        FormRow {
            label: "Refresh rate";
            icon: Icons.gauge;
            hint: "Hz, follows the monitor when empty";
            TextField {
                text <=> Edit.vm.refresh;
                placeholder: "follow the monitor";
                mono: true;
            }
        }
    }
    Card {
        title: "Pointer";
        FormRow {
            label: "Capture";
            icon: Icons.mouse-pointer-2;
            hint: Edit.vm.capture == 0 ? "While a game hides the pointer" : Edit.vm.capture == 1 ? "Only on Ctrl+Alt+G" : "Pointer stays free";
            error: Edit.issues.input;
            Select {
                model: Edit.options.captures;
                current-index <=> Edit.vm.capture;
            }
        }
        FormRow {
            label: "USB tablet";
            icon: Icons.mouse-pointer-2;
            hint: "Absolute pointer";
            Switch {
                checked <=> Edit.vm.tablet;
                enabled: !Edit.locked;
                label: "USB tablet";
            }
        }
    }
}
