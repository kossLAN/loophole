import { Theme } from "../theme.slint";
import { VmItem } from "../state.slint";
import { Edit, EditMode, HostDevices, Picking } from "state.slint";
import { Confirm, StatusBar, StatusDot } from "../components/index.slint";
import { VmPane } from "vm-pane.slint";
import { DevicePicker } from "device-picker.slint";

export component SettingsWindow inherits Window {
    in property <VmItem> vm;
    in property <string> message;

    in-out property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-action;
    callback confirmed();

    property <bool> creating: Edit.mode == EditMode.create;

    title: (root.creating ? "New VM" : root.vm.name + " settings") + " – loophole";
    background: Theme.bg;
    preferred-width: 1080px;
    preferred-height: 820px;
    min-width: 720px;
    min-height: 480px;
    default-font-size: Theme.font-md;

    VerticalLayout {
        Rectangle {
            height: Theme.header-h;
            background: Theme.bg;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: Theme.space-5;
                padding-right: Theme.space-4;
                if !root.creating: VerticalLayout {
                    alignment: center;
                    padding-right: 8px;
                    StatusDot {
                        state: root.vm.state;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: root.creating ? "New VM" : root.vm.name;
                        color: Theme.fg;
                        font-size: Theme.font-xl;
                        font-weight: 650;
                        overflow: elide;
                    }
                    if !root.creating: Text {
                        text: root.vm.state + (root.vm.summary != "" ? "  " + root.vm.summary : "");
                        color: Theme.muted;
                        font-size: Theme.font-sm;
                        overflow: elide;
                    }
                }
            }
        }

        if Edit.mode != EditMode.hidden: VmPane {
            vertical-stretch: 1;
        }
        if Edit.mode == EditMode.hidden: Rectangle {
            vertical-stretch: 1;
        }

        if root.message != "": StatusBar {
            message: root.message;
        }
    }

    if HostDevices.picking != Picking.closed: DevicePicker { }

    if root.confirm-open: Confirm {
        title: root.confirm-title;
        text: root.confirm-text;
        action: root.confirm-action;
        confirmed => { root.confirmed(); }
        close => { root.confirm-open = false; }
    }
}
